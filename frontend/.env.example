# Which API the browser talks to. "mock" serves the in-app scripted engine under /api/mock; "real" targets NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=real
# Base URL of the real interview backend (BFF). Only used when NEXT_PUBLIC_API_MODE=real.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Public app URL (used for absolute links in metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only: shared secret for the mock console login (dev only; never reuse in production).
CONSOLE_DEV_PASSWORD=change-me
# Server-only: cookie signing secret for the console session cookie.
CONSOLE_COOKIE_SECRET=replace-with-32-byte-random

# ---- Real mode (server-only; never NEXT_PUBLIC_) ----
# Gemini key: https://aistudio.google.com/apikey  → this is the ONLY place the key goes.
GEMINI_API_KEY=
# Model used for every prompt in a session (3.5-flash verified with prompts_v2; flash-lite skips anchor-first).
GEMINI_MODEL=gemini-3.5-flash
# Whisper transcription service from voice_to_text/server.py
WHISPER_URL=http://127.0.0.1:8008
# Optional overrides
# PROMPTS_DIR=../prompts_v2
# DATA_DIR=.data
